<script>
  const mermaidSelector = 'pre[data-language="mermaid"] > code';
  const renderedAttribute = "data-mermaid-rendered";
  const rendering = new WeakSet<HTMLElement>();
  let mermaidPromise: ReturnType<typeof importMermaid> | undefined;

  const importMermaid = () =>
    import("mermaid").then(({ default: mermaid }) => {
      mermaid.initialize({
        startOnLoad: false,
        theme: "dark",
        securityLevel: "strict",
        themeVariables: {
          fontFamily:
            '"PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", "Source Han Sans CN", -apple-system, sans-serif',
        },
      });

      return mermaid;
    });

  const initializeMermaid = async () => {
    if (!mermaidPromise) {
      mermaidPromise = importMermaid();
    }

    return mermaidPromise;
  };

  const renderMermaidBlocks = async () => {
    const blocks = Array.from(
      document.querySelectorAll<HTMLElement>(mermaidSelector),
    ).filter((block) => block.dataset.mermaidRendered !== "true" && !rendering.has(block));

    if (blocks.length === 0) {
      return;
    }

    blocks.forEach((block) => rendering.add(block));

    try {
      const mermaid = await initializeMermaid();
      await Promise.all(
        blocks.map(async (block, index) => {
          const source = block.textContent?.trim();

          if (!source || !block.isConnected) return;

          const wrapper = document.createElement("div");
          wrapper.className =
            "my-6 flex justify-center overflow-x-auto rounded-xl border bg-card p-4";

          try {
            const id = `mermaid-${Date.now()}-${index}`;
            const { svg } = await mermaid.render(id, source);
            if (!block.isConnected) return;

            wrapper.innerHTML = svg;
            wrapper.querySelector("svg")?.classList.add("max-w-full");
            block.closest("pre")?.replaceWith(wrapper);
          } catch (error) {
            block.setAttribute(renderedAttribute, "true");
            block.closest("pre")?.classList.add("border-destructive/20");
            console.error("Mermaid 渲染失败：", error);
          }
        }),
      );
    } catch (error) {
      mermaidPromise = undefined;
      console.error("Mermaid 加载失败：", error);
    } finally {
      blocks.forEach((block) => rendering.delete(block));
    }
  };

  document.addEventListener("astro:page-load", () => {
    void renderMermaidBlocks();
  });

  void renderMermaidBlocks();
</script>
