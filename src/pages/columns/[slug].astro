---
import { getCollection } from "astro:content";
import ThreeColumnLayout from "@layouts/ThreeColumnLayout.astro";
import LeftSidebar from "@components/widgets/LeftSidebar.astro";
import RightSidebar from "@components/widgets/RightSidebar.astro";
import BlogPostCard from "@components/blog/BlogPostCard.astro";
import { CREATE_TIME } from "@src/consts";
import { getPostsData } from "@src/hooks/usePostsData";
import { columnDefinitions } from "@features/columns/data/columns";
import {
  getColumnPosts,
  getColumnDefinition,
  validateColumnReferences,
} from "@features/columns/columnUtils";
import type { BlogPost, ColumnDefinition } from "@features/columns/types";

export async function getStaticPaths() {
  const posts = await getCollection("blog", ({ data }) => !data.draft);
  validateColumnReferences(posts, columnDefinitions);

  return columnDefinitions.map((definition) => ({
    params: { slug: definition.slug },
    props: {
      definition,
      posts: getColumnPosts(posts, definition.slug),
    },
  }));
}

interface Props {
  definition: ColumnDefinition;
  posts: BlogPost[];
}

const { definition, posts } = Astro.props;
const { totalPostsCounts, totalPostsWords, totalTagsCounts } =
  await getPostsData();

const resolvedDefinition = getColumnDefinition(
  columnDefinitions,
  definition.slug,
);

if (!resolvedDefinition) {
  throw new Error(`Column "${definition.slug}" is not defined`);
}

const siteData = {
  createTime: CREATE_TIME,
  articleCount: totalPostsCounts,
  tagCount: totalTagsCounts,
  wordCount: totalPostsWords,
};
---

<ThreeColumnLayout
  title={`${resolvedDefinition.title} - 专栏`}
  description={resolvedDefinition.description}
>
  <LeftSidebar slot="left-sidebar" />

  <main class="w-full py-4 sm:py-8">
    <header
      class="mb-10 border-b border-gray-200 pb-8 dark:border-gray-700 sm:mb-14"
    >
      <a
        href="/columns/"
        class="mb-5 inline-block text-sm text-blue-600 hover:underline dark:text-blue-400"
      >
        ← 返回专栏列表
      </a>
      <h1
        class="mb-4 text-3xl font-bold text-gray-900 sm:text-4xl md:text-5xl dark:text-gray-100"
      >
        {resolvedDefinition.title}
      </h1>
      <p class="mb-3 max-w-3xl text-base leading-7 text-gray-600 dark:text-gray-400">
        {resolvedDefinition.description}
      </p>
      <p class="font-mono text-sm text-gray-500 dark:text-gray-400">
        共 {posts.length} 篇文章
      </p>
    </header>

    {
      posts.length > 0 ? (
        <div class="grid gap-5 sm:gap-6 md:grid-cols-2 lg:gap-8 xl:grid-cols-3">
          {posts.map((post, index) => (
            <BlogPostCard post={post} eager={index < 3} />
          ))}
        </div>
      ) : (
        <div class="rounded-xl border border-gray-200 bg-white p-8 text-center text-sm text-muted-foreground dark:border-gray-700 dark:bg-gray-800/50">
          该专栏暂未收录文章
        </div>
      )
    }
  </main>

  <RightSidebar slot="right-sidebar" siteData={siteData} />
</ThreeColumnLayout>